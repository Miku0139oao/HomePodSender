{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomePodSender",
  "version": "2.0.0",
  "identifier": "com.homepodsender.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run sidecar:debug && npm run dev:web",
    "beforeBuildCommand": "npm run sidecar && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar-publish/HomePodSidecar.exe": "sidecar/HomePodSidecar.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
