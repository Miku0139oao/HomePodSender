<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Liquid Glass：色板 ===== -->
    <Color x:Key="AppleRed">#FA233B</Color>
    <Color x:Key="ApplePink">#FF6482</Color>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="BaseBrush" Color="#0A0A10"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#A8FFFFFF"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FA233B"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#FF8A80"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#30D158"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1FFFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A88" Offset="0"/>
        <GradientStop Color="#FA233B" Offset="1"/>
    </LinearGradientBrush>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <!-- ===== 玻璃材质 ===== -->
    <!-- 主体填充：顶部微亮、底部带一点折射暗边，让玻璃有厚度 -->
    <LinearGradientBrush x:Key="GlassFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2BFFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.45"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.82"/>
        <GradientStop Color="#2E101018" Offset="1"/>
    </LinearGradientBrush>
    <!-- 镜面边：左上强高光、右下回光 -->
    <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B8FFFFFF" Offset="0"/>
        <GradientStop Color="#24FFFFFF" Offset="0.36"/>
        <GradientStop Color="#14FFFFFF" Offset="0.62"/>
        <GradientStop Color="#70FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRimSoftBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#80FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.45"/>
        <GradientStop Color="#4DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- 由上而下的柔性高光 -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.32"/>
        <GradientStop Color="#00FFFFFF" Offset="0.62"/>
    </LinearGradientBrush>
    <!-- 斜向反光带 -->
    <LinearGradientBrush x:Key="GlassGlintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.4"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.49"/>
        <GradientStop Color="#00FFFFFF" Offset="0.58"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- 底部面板：更实的深色玻璃，保证文字可读 -->
    <LinearGradientBrush x:Key="GlassSheetFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F523232D" Offset="0"/>
        <GradientStop Color="#F517171F" Offset="0.55"/>
        <GradientStop Color="#FA0F0F15" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassInsetBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="GlassPressedBrush" Color="#3BFFFFFF"/>
    <!-- 折射色散：玻璃内圈极淡的青/品红反光 -->
    <LinearGradientBrush x:Key="GlassChromaticRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E96C8FF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#2EFF5C9A" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 工具提示 ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F0202028" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 液态玻璃播放键 ===== -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse Fill="{StaticResource AccentGradient}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#FF2D5E"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- 顶部柔光 -->
                        <Ellipse IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush Center="0.3,0.12" GradientOrigin="0.3,0.12" RadiusX="1.05" RadiusY="0.95">
                                    <GradientStop Color="#66FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- 厚玻璃边 -->
                        <Ellipse IsHitTestVisible="False" StrokeThickness="1.4" Stroke="{StaticResource GlassRimBrush}"/>
                        <Ellipse IsHitTestVisible="False" StrokeThickness="1" Stroke="#12FFFFFF" Margin="1.6"/>
                        <!-- 旋转光束描边（Border Beam 的 WPF 等价实现） -->
                        <Ellipse IsHitTestVisible="False" StrokeThickness="2">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <LinearGradientBrush.RelativeTransform>
                                        <RotateTransform x:Name="BeamSpin" CenterX="0.5" CenterY="0.5"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.36"/>
                                    <GradientStop Color="#E6FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.64"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <Ellipse x:Name="Hover" IsHitTestVisible="False" Fill="#1FFFFFFF" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BeamSpin" Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:6.5" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 常显玻璃圆形按钮（底部工具、窗口按钮） ===== -->
    <Style x:Key="GlassIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Fill" Fill="#1FFFFFFF"/>
                        <Ellipse IsHitTestVisible="False" StrokeThickness="1" Stroke="{StaticResource GlassRimSoftBrush}"/>
                        <Ellipse IsHitTestVisible="False" Fill="{StaticResource GlassSheenBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#38FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#4DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 图标按钮（无底，悬停出现玻璃圆） ===== -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Hover" Fill="#26FFFFFF" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Fill" Value="#3BFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Fill" Fill="#1FFFFFFF"/>
                        <Ellipse IsHitTestVisible="False" StrokeThickness="1" Stroke="{StaticResource GlassRimSoftBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#E5484D"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#C33A3F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Fill" Fill="#1FFFFFFF"/>
                        <Ellipse IsHitTestVisible="False" StrokeThickness="1" Stroke="{StaticResource GlassRimSoftBrush}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#38FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="#4DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 玻璃胶囊按钮 -->
    <Style x:Key="GlassPill" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="17,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="999" Background="#24FFFFFF" BorderBrush="{StaticResource GlassRimSoftBrush}" BorderThickness="1"/>
                        <Border x:Name="Sheen" CornerRadius="999" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 强调色玻璃胶囊（主操作） -->
    <Style x:Key="AccentPill" TargetType="Button" BasedOn="{StaticResource GlassPill}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border CornerRadius="999" Background="{StaticResource AccentGradient}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#FF2D5E"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="999" Background="#1FFFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                        <Border CornerRadius="999" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 面板右上角“完成”文字按钮 -->
    <Style x:Key="TextAccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF7D92"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="14" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 音量条 ===== -->
    <Style x:Key="SliderFillButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" CornerRadius="3" Background="White" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.55" Color="#FFFFFF"/>
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmptyButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="30" Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="18" Height="18" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="9" ShadowDepth="1.5" Opacity="0.45" Color="#000000"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="15" Height="15" Fill="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppleSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="AutoToolTipPlacement" Value="TopLeft"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SliderThumb" Style="{StaticResource SliderThumbStyle}" Opacity="0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SliderThumb" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseCaptureWithin" Value="True">
                            <Setter TargetName="SliderThumb" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== iOS 风格开关 ===== -->
    <Style x:Key="AppleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="Track" Grid.Column="1" Width="51" Height="31" CornerRadius="15.5" Background="#3DFFFFFF"
                                BorderBrush="#40FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="27" Height="27" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GreenBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#66FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="22,0,0,0" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="2,0,0,0" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 分段控件 ===== -->
    <Style x:Key="Segmented" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="11" Padding="0,7" Margin="2" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Border x:Name="Sheen" CornerRadius="10" Background="{StaticResource GlassSheenBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF"/>
                            <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 设备列表行 ===== -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="16" Padding="10,10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#26FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 输入框 ===== -->
    <Style x:Key="FieldTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="SelectionBrush" Value="#80FA233B"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#1A000000" CornerRadius="15" Padding="14,10" BorderBrush="#26FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF"/>
                            <Setter TargetName="Bd" Property="Background" Value="#26000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框文本（日志） -->
    <Style x:Key="PlainTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
