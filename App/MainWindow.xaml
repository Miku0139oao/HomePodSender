<Window x:Class="HomePodSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HomePod 推流" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BaseBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="Window_KeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="#1FFFFFFF" Background="{StaticResource BaseBrush}" ClipToBounds="True">
        <Grid>
            <!-- ===== 背景：液态玻璃后面的彩色光斑 ===== -->
            <Canvas x:Name="Backdrop" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="Blob1" Width="660" Height="660" Canvas.Left="-280" Canvas.Top="-260">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="B1a" Color="#584B5BD6" Offset="0"/>
                            <GradientStop x:Name="B1b" Color="#004B5BD6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B1T"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob2" Width="640" Height="640" Canvas.Left="90" Canvas.Top="120">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="B2a" Color="#588E5BFF" Offset="0"/>
                            <GradientStop x:Name="B2b" Color="#008E5BFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B2T"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob3" Width="620" Height="620" Canvas.Left="-260" Canvas.Top="300">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="B3a" Color="#582AA8B8" Offset="0"/>
                            <GradientStop x:Name="B3b" Color="#002AA8B8" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="B3T"/></Ellipse.RenderTransform>
                </Ellipse>
                <!-- 固定的一点青色，增加液体层次 -->
                <Ellipse Width="460" Height="460" Canvas.Left="210" Canvas.Top="30" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2E35C7FF" Offset="0"/>
                            <GradientStop Color="#0035C7FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#00000000" Offset="0.35"/>
                        <GradientStop Color="#6B000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ===== 主内容 ===== -->
            <StackPanel x:Name="MainStack">
                <!-- 标题栏 -->
                <Grid Height="46" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" CornerRadius="13"
                            Background="#16FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="10,5" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="48" Height="48">
                                    <Path Data="M 9,31 A 18,18 0 1 1 39,31 M 15,29 A 11,11 0 1 1 33,29"
                                          Stroke="#CCFFFFFF" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Path Data="M 24,28 L 33.5,42 L 14.5,42 Z" Fill="#CCFFFFFF" Stroke="#CCFFFFFF"
                                          StrokeThickness="2.8" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="HomePod" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center" Margin="6,0,0,1"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button x:Name="MinButton" Style="{StaticResource MinButton}" Width="30" Height="30" Click="Min_Click" ToolTip="最小化">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Width="30" Height="30" Margin="8,0,0,0" Click="Close_Click" ToolTip="收到托盘（右键托盘图标可退出）">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 封面：玻璃里的彩色渐变 + 高光 -->
                <Grid Width="244" Height="244" HorizontalAlignment="Center" Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Ellipse Width="300" Height="300" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#45FF3D6E" Offset="0"/>
                                <GradientStop Color="#00FF3D6E" Offset="0.72"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border x:Name="Cover" CornerRadius="30">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="CoverS1" Color="#59FFFFFF" Offset="0"/>
                                <GradientStop x:Name="CoverS2" Color="#1FFFFFFF" Offset="0.55"/>
                                <GradientStop x:Name="CoverS3" Color="#14000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="46" ShadowDepth="18" Direction="270" Opacity="0.55" Color="#000000"/>
                        </Border.Effect>
                    </Border>
                    <!-- 斜向反光 -->
                    <Border CornerRadius="30" Background="{StaticResource GlassGlintBrush}" IsHitTestVisible="False"/>
                    <!-- 顶部柔光 -->
                    <Border CornerRadius="30" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                    <!-- 厚玻璃边 -->
                    <Border CornerRadius="30" BorderThickness="1" IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8CFFFFFF" Offset="0"/>
                                <GradientStop Color="#14FFFFFF" Offset="0.45"/>
                                <GradientStop Color="#4DFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                    <Border CornerRadius="29" BorderThickness="1" Margin="1" BorderBrush="#14FFFFFF" IsHitTestVisible="False"/>

                    <!-- AirPlay 图标 -->
                    <Viewbox x:Name="CoverIcon" Width="84" Height="84" VerticalAlignment="Top" Margin="0,92,0,0" IsHitTestVisible="False">
                        <Viewbox.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                        </Viewbox.Effect>
                        <Canvas Width="48" Height="48">
                            <Path x:Name="IconArcs" Data="M 9,31 A 18,18 0 1 1 39,31 M 15,29 A 11,11 0 1 1 33,29"
                                  Stroke="#F2FFFFFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path x:Name="IconTri" Data="M 24,28 L 33.5,42 L 14.5,42 Z" Fill="#F2FFFFFF" Stroke="#F2FFFFFF"
                                  StrokeThickness="2.5" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <!-- 声波可视化 -->
                    <Canvas x:Name="Bars" Width="210" Height="64" VerticalAlignment="Bottom" Margin="0,0,0,34" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>

                <!-- 标题 / 副标题 -->
                <StackPanel Margin="30,22,30,0">
                    <TextBlock x:Name="TitleText" Text="未在播放" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Text="点击 ▶ 推流到 HomePod" FontSize="14.5" Foreground="{StaticResource Text2Brush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 玻璃进度卡：实时声音电平 -->
                <Border Margin="20,18,20,0" CornerRadius="26" Background="{StaticResource GlassFillBrush}"
                        BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="25" BorderThickness="1" BorderBrush="{StaticResource GlassChromaticRimBrush}" Margin="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="26" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <Grid Margin="16,13,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Height="8">
                                <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="LevelTrack" Height="6" Background="Transparent" VerticalAlignment="Center">
                                    <Border x:Name="LevelFill" Height="6" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6" Color="#B3FFFFFF"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,8,2,0">
                                <TextBlock x:Name="ElapsedText" Text="--:--" FontSize="12" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center"/>
                                <Border x:Name="LiveBadge" HorizontalAlignment="Right" Background="#40FF3D6E" BorderBrush="#59FF8AA0"
                                        BorderThickness="1" CornerRadius="9" Padding="7,2,7,2" Visibility="Hidden">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="#FFFF7D92" VerticalAlignment="Center"/>
                                        <TextBlock Text="实时" FontSize="10.5" FontWeight="Bold" Foreground="White" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 玻璃音量胶囊 -->
                <Border Margin="20,12,20,0" Height="52" CornerRadius="26" Background="{StaticResource GlassFillBrush}"
                        BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="25" BorderThickness="1" BorderBrush="{StaticResource GlassChromaticRimBrush}" Margin="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="26" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <Grid Margin="9,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="34" Height="34" Click="Mute_Click" ToolTip="静音 / 恢复">
                                <TextBlock x:Name="VolLowIcon" Text="&#xE992;" FontFamily="{StaticResource IconFont}" FontSize="15"/>
                            </Button>
                            <Slider x:Name="VolSlider" Grid.Column="1" Style="{StaticResource AppleSlider}" Margin="8,0,8,0" Value="20" AutoToolTipPrecision="0" ValueChanged="Vol_Changed" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 底部玻璃工具条：AirPlay / 播放 / 设置 -->
                <Border Margin="20,14,20,20" Height="88" CornerRadius="44" Background="{StaticResource GlassFillBrush}"
                        BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="43" BorderThickness="1" BorderBrush="{StaticResource GlassChromaticRimBrush}" Margin="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="44" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DevicesButton" Style="{StaticResource GlassIconButton}" Width="46" Height="46" HorizontalAlignment="Left" Click="Devices_Click" ToolTip="选择 HomePod">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="48" Height="48">
                                        <Path x:Name="DevArcs" Data="M 9,31 A 18,18 0 1 1 39,31 M 15,29 A 11,11 0 1 1 33,29" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path x:Name="DevTri" Data="M 24,28 L 33.5,42 L 14.5,42 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource GlassButton}" Width="68" Height="68" Click="Play_Click"
                                    MouseEnter="Play_MouseEnter" MouseLeave="Play_MouseLeave" RenderTransformOrigin="0.5,0.5" ToolTip="连接 / 断开">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1"/>
                                </Button.RenderTransform>
                                <Grid>
                                    <Viewbox x:Name="PlayShape" Width="30" Height="30" Margin="4,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="28" Height="28">
                                            <Path Data="M 6,3.5 L 6,24.5 L 24,14 Z" Fill="White" Stroke="White" StrokeThickness="3" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Viewbox x:Name="PauseShape" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Canvas Width="28" Height="28">
                                            <Path Data="M 5.5,4.5 L 10.5,4.5 L 10.5,23.5 L 5.5,23.5 Z M 17.5,4.5 L 22.5,4.5 L 22.5,23.5 L 17.5,23.5 Z" Fill="White" Stroke="White" StrokeThickness="3" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Ellipse x:Name="PlaySpinner" Width="34" Height="34" StrokeThickness="3.5" Stroke="White" StrokeDashArray="3.4 6.5" StrokeDashCap="Round"
                                             Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="PlaySpin" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Button>
                            <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource GlassIconButton}" Width="46" Height="46" HorizontalAlignment="Right" Click="Settings_Click" ToolTip="设置">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="19"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===== 底部弹出面板层 ===== -->
            <Grid x:Name="Overlay" Visibility="Collapsed">
                <Border x:Name="Scrim" Background="#A6000000" Opacity="0" MouseLeftButtonDown="Scrim_Down"/>

                <!-- 设备面板 -->
                <Border x:Name="DevicesSheet" VerticalAlignment="Bottom" Margin="10,0,10,10" CornerRadius="34"
                        Background="{StaticResource GlassSheetFillBrush}" BorderThickness="1" BorderBrush="{StaticResource GlassRimBrush}"
                        Padding="18,10,18,18" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><TranslateTransform x:Name="DevicesShift" Y="700"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.65" Color="#000000"/></Border.Effect>
                    <Grid>
                        <Border CornerRadius="33" BorderThickness="1" BorderBrush="{StaticResource GlassChromaticRimBrush}" Margin="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="34" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <StackPanel>
                            <Border Width="40" Height="5" CornerRadius="2.5" Background="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Grid Margin="4,0,0,0">
                                <TextBlock Text="AirPlay" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="完成" Style="{StaticResource TextAccentButton}" HorizontalAlignment="Right" Click="CloseSheet_Click"/>
                            </Grid>
                            <TextBlock Text="立体声对只需连接组长，左右声道会自动分配到两台。若点到成员，会自动改选组长。" FontSize="12.5" Foreground="{StaticResource Text2Brush}"
                                       TextWrapping="Wrap" Margin="4,6,4,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="230">
                                <ItemsControl x:Name="DeviceItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Tag="{Binding Ip}" Click="Device_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                                        <Ellipse Fill="#1FFFFFFF"/>
                                                        <Ellipse Stroke="{StaticResource GlassRimSoftBrush}" StrokeThickness="1"/>
                                                        <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="16.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Ip}" FontSize="12.5" Foreground="{StaticResource Text2Brush}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding RoleText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding RoleBrush}" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasRole, Converter={StaticResource B2V}}"/>
                                                    </StackPanel>
                                                    <Grid Grid.Column="2" Width="26" Height="26" VerticalAlignment="Center" Visibility="{Binding Selected, Converter={StaticResource B2V}}">
                                                        <Ellipse Fill="{StaticResource AccentGradient}"/>
                                                        <Ellipse Stroke="#59FFFFFF" StrokeThickness="1"/>
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="4,10,4,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewIpBox" Style="{StaticResource FieldTextBox}" Text="" ToolTip="手动输入 HomePod 的 IP 地址，例如 192.168.50.71" KeyDown="NewIp_KeyDown" TextChanged="NewIp_TextChanged"/>
                                <TextBlock x:Name="NewIpHint" Text="手动输入 IP，如 192.168.50.71" FontSize="14.5" Foreground="{StaticResource Text3Brush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,0,1"/>
                                <Button Grid.Column="1" Content="添加" Style="{StaticResource AccentPill}" Margin="10,0,0,0" Click="AddIp_Click"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Button x:Name="ScanButton" Content="扫描局域网设备" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Click="Scan_Click"/>
                                <TextBlock x:Name="ScanStatus" Text="" FontSize="12.5" Foreground="{StaticResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设置面板 -->
                <Border x:Name="SettingsSheet" VerticalAlignment="Bottom" Margin="10,0,10,10" CornerRadius="34"
                        Background="{StaticResource GlassSheetFillBrush}" BorderThickness="1" BorderBrush="{StaticResource GlassRimBrush}"
                        Padding="18,10,18,18" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><TranslateTransform x:Name="SettingsShift" Y="700"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.65" Color="#000000"/></Border.Effect>
                    <Grid>
                        <Border CornerRadius="33" BorderThickness="1" BorderBrush="{StaticResource GlassChromaticRimBrush}" Margin="1" IsHitTestVisible="False"/>
                        <Border CornerRadius="34" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False"/>
                        <StackPanel>
                            <Border Width="40" Height="5" CornerRadius="2.5" Background="#4DFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Grid Margin="4,0,0,0">
                                <TextBlock Text="设置" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="完成" Style="{StaticResource TextAccentButton}" HorizontalAlignment="Right" Click="CloseSheet_Click"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="470">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="播放延迟" FontSize="13" Foreground="{StaticResource Text2Brush}" Margin="4,0,0,8"/>
                                    <Border Background="#18000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14" Padding="2">
                                        <UniformGrid Rows="1">
                                            <RadioButton x:Name="Lat500" Style="{StaticResource Segmented}" Content="0.5 秒" GroupName="lat" Checked="Latency_Checked" Tag="500"/>
                                            <RadioButton x:Name="Lat1000" Style="{StaticResource Segmented}" Content="1 秒" GroupName="lat" Checked="Latency_Checked" Tag="1000"/>
                                            <RadioButton x:Name="Lat1500" Style="{StaticResource Segmented}" Content="1.5 秒" GroupName="lat" Checked="Latency_Checked" Tag="1500" IsChecked="True"/>
                                            <RadioButton x:Name="Lat2000" Style="{StaticResource Segmented}" Content="2 秒" GroupName="lat" Checked="Latency_Checked" Tag="2000"/>
                                        </UniformGrid>
                                    </Border>
                                    <TextBlock Text="延迟越大越抗网络抖动；看视频请选小一点，否则画面与声音会不同步。修改后下次连接生效。"
                                               FontSize="12" Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" Margin="4,8,4,14"/>
                                    <Rectangle Height="1" Fill="{StaticResource SeparatorBrush}" Margin="4,0,4,14"/>
                                    <CheckBox x:Name="ChkAuto" Style="{StaticResource AppleSwitch}" Content="断线自动重连" Margin="4,0,4,14" Checked="Opt_Changed" Unchecked="Opt_Changed"/>
                                    <CheckBox x:Name="ChkStart" Style="{StaticResource AppleSwitch}" Content="启动程序时自动连接" Margin="4,0,4,14" Checked="Opt_Changed" Unchecked="Opt_Changed"/>
                                    <CheckBox x:Name="ChkLog" Style="{StaticResource AppleSwitch}" Content="显示日志" Margin="4,0,4,0" Checked="Log_Toggled" Unchecked="Log_Toggled"/>
                                    <Border x:Name="LogBox" Background="#1A000000" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14" Margin="0,14,0,0" Padding="12,10" Visibility="Collapsed">
                                        <TextBox x:Name="LogText" Style="{StaticResource PlainTextBox}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="#B3FFFFFF"
                                                 IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Hidden"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
